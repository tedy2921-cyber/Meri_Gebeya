# Meri Gebeya reads exactly these variables (server/src/config.js).
# Zero-dependency setup: there is no dotenv. Start with either
#   node --env-file-if-exists=.env server/src/server.js     (npm run start:env)
#   export $(grep -v '^#' .env | xargs)                     (POSIX shells)

# development | production  — production turns on the Secure cookie flag and asset caching
NODE_ENV=development

# Port and bind address. Keep 127.0.0.1 unless you want the shop reachable on your network.
PORT=4000
HOST=127.0.0.1

# Where meri-gebeya.db (and its -wal / -shm files) live. Created automatically.
# Use a mounted volume in Docker, e.g. /data
# MG_DATA_DIR=/absolute/path

# CHANGE THIS before the shop is reachable by anyone else. It keys the session HMAC.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MG_SECRET=replace-me-with-a-long-random-string
